APP_NAME="CpE Student Development Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FAKER_LOCALE=en_PH

# Institution branding shown in the header and on exported portfolios.
INSTITUTION_NAME="University of Saint Louis Tuguegarao"
INSTITUTION_UNIT="School of Engineering, Architecture and Information Technology Education"
INSTITUTION_PROGRAM="BS Computer Engineering"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpe_plo_portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="portfolio@usl.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

# --- Assessment policy knobs -------------------------------------------------
# Mean score (1-4 scale) at or above which a PLO counts as attained.
PLO_ATTAINMENT_TARGET=3.00
# Minimum evidence-quality rating (1-4) for evidence to count as valid direct
# assessment. Quality 1-2 evidence is stored but excluded from the calculation.
PLO_MIN_EVIDENCE_QUALITY=3
